// ============================================================================
// DolphinDB Schema Initialization Script
// Project: SparkTrade-MFT Raw Data Layer
// Date: 2026-08-06
// Purpose: Create database and tables for market data storage
// ============================================================================

// Login
login("admin", "123456")

// ============================================================================
// Step 1: Create Database (if not exists)
// ============================================================================
print("Step 1: Creating database...")

if(existsDatabase("dfs://raw_data")) {
    print("Database dfs://raw_data already exists")
    db = database("dfs://raw_data")
} else {
    // Partition by month (2020-2030)
    db = database("dfs://raw_data", VALUE, 2020.01M..2030.12M)
    print("✅ Database dfs://raw_data created (VALUE partition by month)")
}

// ============================================================================
// Step 2: Create raw_events Table (BLOB storage for untouched payloads)
// ============================================================================
print("Step 2: Creating raw_events table...")

if(existsTable("dfs://raw_data", "raw_events")) {
    print("Table raw_events already exists")
} else {
    schema_raw = table(
        100:0,
        `event_id`source`payload`received_at`sequence_num,
        [STRING, SYMBOL, BLOB, TIMESTAMP, LONG]
    )
    
    db.createPartitionedTable(schema_raw, `raw_events, `received_at)
    print("✅ Table raw_events created")
    print("   Columns: event_id(STRING), source(SYMBOL), payload(BLOB), received_at(TIMESTAMP), sequence_num(LONG)")
    print("   Partition: received_at (monthly)")
}

// ============================================================================
// Step 3: Create canonical_events Table (structured market data)
// ============================================================================
print("Step 3: Creating canonical_events table...")

if(existsTable("dfs://raw_data", "canonical_events")) {
    print("Table canonical_events already exists")
} else {
    schema_canonical = table(
        100:0,
        `event_id`canonical_symbol`exchange_timestamp`local_hw_timestamp`event_type`price`size`side`source`raw_event_id,
        [STRING, SYMBOL, TIMESTAMP, TIMESTAMP, SYMBOL, DOUBLE, DOUBLE, SYMBOL, SYMBOL, STRING]
    )
    
    db.createPartitionedTable(schema_canonical, `canonical_events, `exchange_timestamp)
    print("✅ Table canonical_events created")
    print("   Columns: event_id, canonical_symbol, exchange_timestamp, local_hw_timestamp, event_type, price, size, side, source, raw_event_id")
    print("   Partition: exchange_timestamp (monthly)")
}

// ============================================================================
// Step 4: Verify Tables
// ============================================================================
print("Step 4: Verifying tables...")

raw_count = exec count(*) from loadTable("dfs://raw_data", "raw_events")
canonical_count = exec count(*) from loadTable("dfs://raw_data", "canonical_events")

print("✅ raw_events row count: " + string(raw_count))
print("✅ canonical_events row count: " + string(canonical_count))

// ============================================================================
// Summary
// ============================================================================
print("")
print("═══════════════════════════════════════════════════════════")
print("  DolphinDB Schema Initialization Complete!")
print("═══════════════════════════════════════════════════════════")
print("")
print("Database: dfs://raw_data")
print("Tables:")
print("  1. raw_events (BLOB payload storage)")
print("  2. canonical_events (normalized market data)")
print("")
print("Ready to receive real market data from adapters!")
print("═══════════════════════════════════════════════════════════")
